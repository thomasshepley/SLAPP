<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Host's window and tray icon. Runs as the logged-in user and talks to
       the service over 127.0.0.1:4432; the service does anything needing admin. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TitanDeckHost.App</RootNamespace>
    <AssemblyName>TitanDeckHost</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The TitanDeck icon with HOST on it (tools/make_icon.py draws it). -->
    <ApplicationIcon>Assets\TitanDeckHost.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\TitanDeckHost.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/TitanDeckHost.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms and WPF both have an Application, Button... - WPF wins by default. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>

<Window x:Class="TitanDeckHost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TitanDeck Host" Width="760" Height="820" MinWidth="560" MinHeight="500"
        Background="{StaticResource Background}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <DockPanel>
        <!-- Status bar for fix results -->
        <Border DockPanel.Dock="Bottom" Background="#FF161618" Padding="18,10">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,10">
                <!-- Headline -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="18" Height="18" Fill="{Binding HeadlineColour}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SecondaryText}" Margin="30,0,0,20" TextWrapping="Wrap" />

                <!-- Checklist -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Colour}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding FixTitle}" Command="{Binding FixCommand}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasFix, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Pairing -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="iPad and iPhone" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Code}" FontSize="44" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource Accent}" Margin="0,0,0,6"
                                   Visibility="{Binding HasCode, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding CodeHint}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Content="Show a pairing code" Command="{Binding NewCodeCommand}" HorizontalAlignment="Left" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Seen}" Foreground="{StaticResource SecondaryText}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietButton}"
                                                Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Files -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Files" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Files sent from TitanDeck land in To PC. Put files in To iPad and they appear in TitanDeck's Send sheet."
                                   Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding FilesWaitingText}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open To PC" Command="{Binding OpenToPCCommand}" Margin="0,0,10,0" />
                            <Button Content="Open To iPad" Command="{Binding OpenToIPadCommand}" Style="{StaticResource QuietButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="TitanDeckHost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TitanDeck Host" Icon="/Assets/TitanDeckHost.ico" Width="860" Height="900" MinWidth="560" MinHeight="500"
        Background="{StaticResource Background}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <DockPanel>
        <!-- Status bar for fix results -->
        <Border DockPanel.Dock="Bottom" Background="#FF161618" Padding="18,10">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,10">
                <!-- Headline -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="18" Height="18" Fill="{Binding HeadlineColour}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Headline}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Border Grid.Column="2" Background="{Binding ModeBadgeColour}" CornerRadius="10" Padding="12,3" VerticalAlignment="Center"
                            ToolTip="{Binding ModeText}">
                        <TextBlock Text="{Binding ModeBadge}" FontWeight="Bold" FontSize="13" Foreground="Black" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SecondaryText}" Margin="30,0,0,20" TextWrapping="Wrap" />

                <!-- Test or Show -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Mode" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Test" Command="{Binding TestModeCommand}" MinWidth="80" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTestMode}" Value="True">
                                            <Setter Property="Background" Value="#FFFF9F0A" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Show" Command="{Binding ShowModeCommand}" MinWidth="80" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShowMode}" Value="True">
                                            <Setter Property="Background" Value="#FF30D158" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Network for TitanDeck -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Network for TitanDeck" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding NetworkText}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding NetworkProblem}" Foreground="#FFFF9F0A" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasNetworkProblem, Converter={StaticResource Visible}}" />
                        <ComboBox ItemsSource="{Binding AdapterChoices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedAdapterId, Mode=TwoWay}" MinWidth="320" HorizontalAlignment="Left" />
                        <TextBlock Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="The iPad finds this PC by the adapter chosen here. Pick the one on the same network as the iPad (the show network), not the internet or another network." />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Content="{Binding UpdateButton}" Command="{Binding UpdateCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}" />
                            <Button Grid.Column="2" Content="Check for updates" Command="{Binding CheckUpdateCommand}" Style="{StaticResource QuietButton}" />
                        </Grid>
                        <TextBlock Text="{Binding UpdateNotes}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasUpdateNotes, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <!-- Checklist -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Colour}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding FixTitle}" Command="{Binding FixCommand}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasFix, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Pairing -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="iPad and iPhone" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Code}" FontSize="44" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource Accent}" Margin="0,0,0,6"
                                   Visibility="{Binding HasCode, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding CodeHint}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Content="Show a pairing code" Command="{Binding NewCodeCommand}" HorizontalAlignment="Left" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Seen}" Foreground="{StaticResource SecondaryText}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietButton}"
                                                Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Remote desktop picture -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Remote desktop picture" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Best for a wired or strong link, Balanced is Windows' normal, Weak signal for bad Wi-Fi on set. TitanDeck can change this too."
                                   Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding QualityText}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Best" Command="{Binding BestCommand}" Margin="0,0,10,0" />
                            <Button Content="Balanced" Command="{Binding BalancedCommand}" Margin="0,0,10,0" />
                            <Button Content="Weak signal" Command="{Binding WeakSignalCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Files -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Files" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Files sent from TitanDeck land in To PC. Put files in To iPad and they appear in TitanDeck's Send sheet."
                                   Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding FilesWaitingText}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open To PC" Command="{Binding OpenToPCCommand}" Margin="0,0,10,0" />
                            <Button Content="Open To iPad" Command="{Binding OpenToIPadCommand}" Style="{StaticResource QuietButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fake Titan (Test mode only) -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsTestMode, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="Fake Titan" Style="{StaticResource CardTitle}" />
                        <TextBlock Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Pretends to be Titan, so TitanDeck can be tried without a desk or AvoKey: the WebAPI, the desk's selection (desk link) and sACN for live intensity. Close Titan first - they both use port 4430. Every call shows in the Titan log below." />
                        <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding FakeStopped}">
                            <TextBlock Text="Fixtures" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FakeFixtures, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="0,0,16,6" />
                            <TextBlock Text="Playbacks" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FakePlaybacks, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="0,0,16,6" />
                            <TextBlock Text="Slow replies (ms)" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FakeLatency, UpdateSourceTrigger=PropertyChanged}" Width="56" Margin="0,0,16,6" />
                            <CheckBox Content="Desk (UI WebAPI)" IsChecked="{Binding FakeDesk}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,16,6" />
                            <CheckBox Content="sACN levels" IsChecked="{Binding FakeSacn}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,0,6" />
                        </WrapPanel>
                        <Button Content="{Binding FakeButton}" Command="{Binding FakeToggleCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding FakeStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding FakeState}" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasFakeState, Converter={StaticResource Visible}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasFakeState, Converter={StaticResource Visible}}">
                            <TextBlock Text="Select on the desk" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding DeskSelection, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,10,0"
                                     ToolTip="Fixture numbers, e.g. 3,4 or 1-10 - as if you'd clicked them in Layouts" />
                            <Button Content="Select" Command="{Binding DeskSelectCommand}" Margin="0,0,10,0" />
                            <Button Content="Clear" Command="{Binding DeskClearCommand}" Style="{StaticResource QuietButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Patch report -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Patch report" Style="{StaticResource CardTitle}" />
                        <TextBlock Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="So TitanDeck can show a fixture's live level without nudging it first. On Titan: Disk &gt; Reports, tick Fixtures, choose CSV and save it to this PC (Documents\Titan\Reports). The Host reads the newest one and finds each fixture's dimmer channel in Titan's personalities. It only reads files: it never opens Patch. Do it again after repatching." />
                        <TextBlock Text="{Binding PatchText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PatchProblem}" Foreground="#FFFF9F0A" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding HasPatchProblem, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding PatchDetail}" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasPatchDetail, Converter={StaticResource Visible}}" />
                        <WrapPanel>
                            <Button Content="Read again" Command="{Binding ReloadPatchCommand}" Margin="0,0,10,6" />
                            <Button Content="Read a report file..." Command="{Binding ImportPatchCommand}" Style="{StaticResource QuietButton}" Margin="0,0,10,6" />
                            <Button Content="{Binding AskTitanButton}" Command="{Binding AskTitanCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,6"
                                    Visibility="{Binding IsTestMode, Converter={StaticResource Visible}}"
                                    ToolTip="Experimental: asks Titan's WebAPI (its separate user, not your desk's screens) to write a patch report. What Titan answers shows in the Titan log." />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Titan log -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Titan log" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="Follow" IsChecked="{Binding AutoScroll}" Foreground="{StaticResource Text}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="2" Content="Copy" Command="{Binding CopyLogCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="Clear" Command="{Binding ClearLogCommand}" Style="{StaticResource QuietButton}" />
                        </Grid>
                        <TextBlock Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Every call TitanDeck makes to Fake Titan, and to the real desk through the desk link: who sent it, what Titan answered and how long it took. Red is something refused or TitanDeck shouldn't do." />
                        <TextBlock Text="{Binding PollText}" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogRows}" Height="360" Background="#FF1C1C1E"
                                 BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource Text}"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding Colour}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource SecondaryText}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Who, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Call, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Result}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                            <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                            <TextBlock Text="{Binding State}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryText}"
                                                       TextWrapping="Wrap" Visibility="{Binding HasState, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
